rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Authentication & Role Helpers ──────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Role check from custom claims or Firestore profile fallback
    function isRole(role) {
      return signedIn() && (
        request.auth.token.role == role ||
        get(/databases/$(database)/documents/travelerProfiles/$(request.auth.uid)).data.role == role
      );
    }

    function operator() {
      return signedIn() && (
        request.auth.token.role in ['sub_admin', 'admin', 'super_admin'] ||
        get(/databases/$(database)/documents/travelerProfiles/$(request.auth.uid)).data.role in ['sub_admin', 'admin', 'super_admin']
      );
    }

    function admin() {
      return signedIn() && (
        request.auth.token.role in ['admin', 'super_admin'] ||
        get(/databases/$(database)/documents/travelerProfiles/$(request.auth.uid)).data.role in ['admin', 'super_admin']
      );
    }

    function superAdmin() {
      return signedIn() && (
        request.auth.token.role == 'super_admin' ||
        get(/databases/$(database)/documents/travelerProfiles/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // ─── Validation Helpers ─────────────────────────────────────────
    function validProfile() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100;
    }

    // ─── Traveler Profiles ──────────────────────────────────────────
    match /travelerProfiles/{uid} {
      allow get: if owns(uid) || operator();
      allow list: if operator();
      allow create: if owns(uid) && validProfile();
      allow update: if owns(uid) || admin();
      allow delete: if superAdmin();
    }

    // ─── Packages & Routes Catalog ──────────────────────────────────
    match /packages/{packageId} {
      // Anyone can browse packages (including unauthenticated guests)
      allow read: if true;
      allow create: if operator();
      allow update: if operator();
      allow delete: if admin();
    }

    // ─── Bookings ───────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Users can create bookings for their UID; guests can create with bookingCode
      allow create: if signedIn() || request.resource.data.bookingCode != null;
      // Users can read their own bookings; Operators can read all
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        operator()
      );
      // Update: operator can update status, user can update traveler note/details
      allow update: if operator() || (
        signedIn() && resource.data.userId == request.auth.uid
      );
      allow list: if operator() || signedIn();
      allow delete: if superAdmin();
    }

    // ─── Support Tickets & Live Messenger ───────────────────────────
    match /supportTickets/{ticketId} {
      // Users can create a ticket with their UID
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
      // User who created ticket or operators can view
      allow get: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        operator()
      );
      allow list: if operator() || signedIn();
      // Operators can update ticket status & assignments; Users can update thread status
      allow update: if operator() || (
        signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid
        )
      );
      allow delete: if superAdmin();

      // Support Ticket Messages Subcollection (Live Chat)
      match /messages/{messageId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.ownerUid == request.auth.uid ||
          operator()
        );
        allow create: if signedIn() && (
          request.resource.data.senderId == request.auth.uid ||
          operator()
        );
        allow update, delete: if operator();
      }
    }

    // ─── Platform & System Settings ─────────────────────────────────
    match /systemSettings/{settingId} {
      // Global branding, support phone, UPI ID, announcements are public
      allow read: if true;
      // Only Admins can modify global settings
      allow write: if admin();
    }

    // ─── Route Reviews & Ratings ────────────────────────────────────
    match /reviews/{reviewId} {
      // Anyone can read approved reviews
      allow read: if resource.data.status == 'approved' || operator();
      // Authenticated users can submit reviews
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      // Admins can approve/moderate reviews; owners can edit their review
      allow update: if operator() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── Marketing Campaigns & Announcements ────────────────────────
    match /campaigns/{campaignId} {
      allow read: if true; // Public announcements
      allow write: if admin();
    }

    // ─── In-App Notifications ───────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.target == 'all'
      );
      allow list: if signedIn();
      allow create: if operator();
      allow update: if signedIn() && resource.data.userId == request.auth.uid; // Mark as read
      allow delete: if operator();
    }

    // ─── Invoices & Billing Documents ───────────────────────────────
    match /invoices/{invoiceId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        operator()
      );
      allow list: if operator();
      allow create, update: if operator();
      allow delete: if superAdmin();
    }

    // ─── Admin Audit Log (Immutable) ────────────────────────────────
    match /adminAuditLog/{logId} {
      allow create: if operator();
      allow read: if admin();
      allow update, delete: if false; // Immutable append-only
    }

    // ─── Realtime Analytics / Admin Stats Cache ─────────────────────
    match /adminStats/{statId} {
      allow read: if operator();
      allow write: if operator();
    }

    // ─── Traveler Wishlist ──────────────────────────────────────────
    match /wishlists/{uid} {
      allow read, write: if owns(uid);
    }
  }
}
